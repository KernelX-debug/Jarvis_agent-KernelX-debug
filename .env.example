# Copia este archivo como .env. No publiques el archivo .env real.
JARVIS_NAME=Jarvis
JARVIS_LANGUAGE=es
JARVIS_DATA_DIR=.jarvis
JARVIS_DRY_RUN=true
JARVIS_MAX_FILE_MB=20

# Voz local
JARVIS_STT_MODEL=small
JARVIS_STT_DEVICE=cpu
JARVIS_STT_COMPUTE_TYPE=int8
JARVIS_MICROPHONE=
JARVIS_TTS_ENABLED=true
JARVIS_TTS_RATE=175
JARVIS_WAKE_WORD=jarvis

# Modelo de lenguaje: none | ollama | openai_compatible | huggingface
JARVIS_LLM_PROVIDER=none
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=qwen2.5:3b
# Sirve para llama.cpp, LM Studio u otro servidor local compatible.
JARVIS_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
JARVIS_OPENAI_MODEL=local-model
JARVIS_OPENAI_API_KEY=
JARVIS_HF_MODEL=
JARVIS_MAX_NEW_TOKENS=384

# Opcional para repositorios privados de Hugging Face.
HF_TOKEN=
